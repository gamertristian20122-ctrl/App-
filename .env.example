# Environment for every app (web, worker). Copy to .env and fill in what you use.
# Validated by loadConfig() in packages/core/src/config.ts; unset values use the defaults shown.
# Generate secrets with: pnpm secrets
# Never commit real values.

# --- runtime ------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# development | test | preview | production (production enforces the strict checks)
APP_ENV=development
# Public base URL of the web app, no trailing slash (https required in production)
APP_URL=http://localhost:3000
# Canonical MCP resource URL; defaults to APP_URL + /api/mcp
MCP_RESOURCE_URL=
# debug | info | warn | error
LOG_LEVEL=info

# --- database -------------------------------------------------------------------
# Postgres connection string (Supabase pooler). Leave empty for local dev on PGlite.
DATABASE_URL=
# Max connections per process
DATABASE_POOL_MAX=5
# PGlite data directory for local dev ("memory" = in-memory)
PGLITE_DATA_DIR=.data/pglite

# --- auth -------------------------------------------------------------------------
# Supabase project URL and anon key (magic-link login for humans)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admin tasks only; never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=
# 1 = local email-only login for development and tests (refused in production)
DEV_AUTH=0
# HMAC key for signed cookies and links, at least 32 characters (required in production and with DEV_AUTH)
SESSION_SECRET=

# --- secrets at rest -----------------------------------------------------------
# AES-256-GCM key ring, newest first: "v2:<base64 32 bytes>,v1:<base64 32 bytes>" (required in production)
TOKEN_ENCRYPTION_KEYS=

# --- OAuth authorization server for MCP clients (seconds) ----------------------
OAUTH_ACCESS_TOKEN_TTL_SEC=3600
OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
OAUTH_CODE_TTL_SEC=300
APPROVAL_NONCE_TTL_SEC=604800

# --- posting provider -----------------------------------------------------------
# upload_post | fake (fake is refused in production)
POSTING_PROVIDER=fake
# Upload-Post API key (required when POSTING_PROVIDER=upload_post)
UPLOAD_POST_API_KEY=
# Optional override of the provider API base URL (the adapter has the default)
UPLOAD_POST_BASE_URL=
# Secret for verifying Upload-Post webhook signatures ("current,previous" while rotating)
UPLOAD_POST_WEBHOOK_SECRET=
# Optional profile username prefix (default brand_); use e.g. stg_ when staging shares the account
UPLOAD_POST_PROFILE_PREFIX=

# --- object storage ---------------------------------------------------------------
# r2 | fs | memory (r2 required in production)
STORAGE_DRIVER=fs
# Directory for STORAGE_DRIVER=fs
STORAGE_FS_DIR=.data/storage
# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- transcription ----------------------------------------------------------------
# chain (Whisper, then AssemblyAI) | whisper | assemblyai | fake (fake is refused in production)
TRANSCRIPTION_PROVIDER=fake
# Self-hosted OpenAI-compatible Whisper server base URL, e.g. https://whisper.internal/v1
WHISPER_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
# AssemblyAI fallback
ASSEMBLYAI_API_KEY=
# Optional override of the AssemblyAI API base URL
ASSEMBLYAI_BASE_URL=

# --- billing ------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Stripe price ids (price_...). When unset, prices are resolved by lookup key
# (starter, plus, pro, extra_brand, extra_clip_hour).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXTRA_BRAND=
STRIPE_PRICE_EXTRA_CLIP_HOUR=

# --- cron ---------------------------------------------------------------------------
# Vercel cron sends "Authorization: Bearer <CRON_SECRET>" (at least 16 characters)
CRON_SECRET=

# --- worker -------------------------------------------------------------------------
# Comma list of worker groups: posting, media, or all
WORKER_TYPES=all
# Defaults to hostname + pid
WORKER_ID=
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
# Health-check port (Railway sets PORT)
PORT=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Chromium executable for playwright-core (renderer). Optional: playwright-core finds its own build via
# PLAYWRIGHT_BROWSERS_PATH. Example: /opt/pw-browsers/chromium-1243/chrome-linux64/chrome
CHROMIUM_PATH=
# Scratch directory for media work
MEDIA_TMP_DIR=tmp/media
